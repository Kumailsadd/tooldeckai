---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TooldeckAI — Starter</title>
    <meta name="description" content="Astro + Svelte + Tailwind starter" />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <main class="max-w-4xl mx-auto p-6 space-y-4">
      <h1 class="text-3xl font-extrabold">TooldeckAI</h1>
      <p class="text-slate-600">Astro + Svelte + Tailwind is ready.</p>
      <a class="inline-flex items-center rounded-lg bg-sky-500 hover:bg-sky-600 text-white px-4 py-2 transition" href="#">
        It works!
      </a>

      <!-- Links to your tools (inside <main>, before </main>) -->
      <p class="mt-6">
        <a class="text-sky-600 hover:underline" href="/tools/pdf/merge/">Open Merge PDF tool</a>
      </p>
      <p class="mt-2">
        <a class="text-sky-600 hover:underline" href="/tools/image/resize/">Open Resize Image tool</a>
      </p>
    </main>
  </body>
</html>